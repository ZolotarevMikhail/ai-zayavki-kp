# Скопируйте этот файл в .env и заполните то, что нужно.
# Без ключа система работает в демо-режиме (без ИИ и расходов).

# Ключ ProxyAPI для реального распознавания документов
PROXYAPI_KEY=

# Модель распознавания (должна понимать текст и картинки)
RECOGNIZER_MODEL=gpt-4o-mini

# Почтовый канал (необязательно): ящик, куда клиент присылает заявки
# Пример: IMAP_HOST=imap.yandex.ru
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Ящик для отправки писем с КП (необязательно): с ним кнопка
# «Отправить» посылает письмо сама и прикладывает Word и Excel.
# Пример: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Канал Telegram (необязательно): токен бота из @BotFather
TELEGRAM_BOT_TOKEN=

# Канал VK (необязательно): токен сообщества (доступ к сообщениям)
# и номер группы, где включены сообщения
VK_ACCESS_TOKEN=
VK_GROUP_ID=

# Ключ для приёма заявок с внешнего сайта (любая строка, как пароль)
API_KEY=

# Права доступа (заполните для работы на нескольких компьютерах):
# руководитель получает кнопку «Прайс», сотрудник работает с заявками.
# STAFF_SEATS — сколько компьютеров сотрудников работает одновременно.
ADMIN_PASSWORD=
STAFF_PASSWORD=
STAFF_SEATS=3

# Ключ всплывающих сообщений; можно не заполнять (сгенерируется сам)
SECRET_KEY=